<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>BerkerDB</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- 'release' (not source/target) also checks we only use Java 25 APIs. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.13.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <executions>
                    <!-- Normal unit tests, regular GC. Zero-allocation tests are excluded here. -->
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludedGroups>zero-alloc</excludedGroups>
                        </configuration>
                    </execution>
                    <!--
                        Zero-allocation tests run in their own JVM under Epsilon GC, a collector
                        that never frees memory. No GC can run, so no allocation can be hidden
                        by a collection; the tests themselves assert an exact allocated-bytes delta of 0.
                        The heap must be big enough for JUnit + Surefire, which do allocate.

                        -Xbatch makes JIT compilation synchronous. Normally the JIT compiles in
                        background threads while the code keeps running interpreted, so whether a
                        warmup loop has really produced compiled code by the time the measurement
                        starts depends on timing. Interpreted and C1 code can allocate where C2
                        code doesn't (escape analysis), so slow runs failed with a few hundred
                        bytes. With -Xbatch the warmup reliably ends in compiled code. The
                        compiled code itself is the same as without it.
                    -->
                    <execution>
                        <id>zero-alloc-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>zero-alloc</groups>
                            <argLine>-XX:+UnlockExperimentalVMOptions -XX:+UseEpsilonGC -Xbatch -Xms256m -Xmx256m</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
